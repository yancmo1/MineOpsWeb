{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mineops.io/schemas/equipment_domain.schema.json",
  "title": "MineOps Equipment Domain",
  "description": "Immutable APK-derived Super Manager equipment data. Source data is retained without assigning gameplay meaning that has not been verified.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "releaseId", "generatedAt", "source", "equipment", "materials", "balancing", "localization"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "releaseId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/equipmentSource" },
    "equipment": { "type": "array", "items": { "$ref": "#/$defs/domainRecord" } },
    "materials": { "type": "array", "items": { "$ref": "#/$defs/domainRecord" } },
    "balancing": { "type": "array", "items": { "$ref": "#/$defs/domainRecord" } },
    "localization": { "type": "array", "items": { "$ref": "#/$defs/domainRecord" } }
  },
  "$defs": {
    "jsonValue": {},
    "equipmentSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rawRecords"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "extraction": { "type": "string", "minLength": 1 },
        "releaseMetadata": { "type": "string", "minLength": 1 },
        "rawRecords": { "type": "array", "items": { "$ref": "#/$defs/rawRecord" } },
        "unresolved": { "type": "array", "items": { "type": "object", "minProperties": 1, "additionalProperties": true } }
      }
    },
    "rawRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetName", "sourceBundle", "sourceAssetPath", "rawEncoding", "rawBytes", "rawSha256", "rawByteLength"],
      "properties": {
        "assetName": { "type": "string", "minLength": 1 },
        "sourceBundle": { "type": "string", "minLength": 1 },
        "sourceAssetPath": { "type": "string", "minLength": 1 },
        "sourceObjectPathId": { "type": ["string", "integer", "null"] },
        "rawEncoding": { "const": "base64" },
        "rawBytes": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
        "rawSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rawByteLength": { "type": "integer", "minimum": 0 }
      }
    },
    "recordSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "assetPath", "objectType"],
      "properties": {
        "bundle": { "type": "string", "minLength": 1 },
        "assetPath": { "type": "string", "minLength": 1 },
        "objectType": { "type": "string", "minLength": 1 },
        "pathId": { "type": ["string", "integer", "null"] }
      }
    },
    "domainRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "canonicalId", "source", "sourceFields", "raw"],
      "properties": {
        "recordId": { "type": "string", "minLength": 1 },
        "canonicalId": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/recordSource" },
        "sourceFields": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
        "raw": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      }
    }
  }
}

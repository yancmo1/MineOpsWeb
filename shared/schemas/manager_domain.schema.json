{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mineops.io/schemas/manager_domain.schema.json",
  "title": "MineOps Manager Domain",
  "description": "Immutable APK-derived manager domain data. Partial manager records are valid when their missing fields are represented by absent optional sections and unresolved evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "releaseId", "generatedAt", "source", "managers"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "releaseId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/source" },
    "managers": { "type": "array", "items": { "$ref": "#/$defs/manager" } }
  },
  "$defs": {
    "jsonValue": {},
    "source": { "type": "object", "additionalProperties": true, "minProperties": 1 },
    "managerSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "assetPath", "objectType"],
      "properties": {
        "bundle": { "type": "string", "minLength": 1 },
        "assetPath": { "type": "string", "minLength": 1 },
        "objectType": { "type": "string", "minLength": 1 },
        "pathId": { "type": ["string", "integer", "null"] }
      }
    },
    "assetRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetName", "sourceBundle", "sourceAssetPath", "rawType"],
      "properties": {
        "assetName": { "type": "string", "minLength": 1 },
        "sourceBundle": { "type": "string", "minLength": 1 },
        "sourceAssetPath": { "type": "string", "minLength": 1 },
        "sourceObjectPathId": { "type": ["string", "integer", "null"] },
        "rawType": { "type": "string", "minLength": 1 },
        "params": { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        "attrs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
        "rawEncoding": { "const": "base64" },
        "rawBytes": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
        "rawSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rawByteLength": { "type": "integer", "minimum": 0 },
        "rawBytesUnresolvedEvidenceId": { "type": "string", "minLength": 1 }
      },
      "anyOf": [{ "required": ["params"] }, { "required": ["attrs"] }],
      "oneOf": [
        {
          "required": ["rawEncoding", "rawBytes", "rawSha256", "rawByteLength"],
          "not": { "required": ["rawBytesUnresolvedEvidenceId"] }
        },
        {
          "required": ["rawBytesUnresolvedEvidenceId"],
          "not": {
            "anyOf": [
              { "required": ["rawEncoding"] },
              { "required": ["rawBytes"] },
              { "required": ["rawSha256"] },
              { "required": ["rawByteLength"] }
            ]
          }
        }
      ]
    },
    "assetGroup": {
      "oneOf": [
        { "$ref": "#/$defs/assetRecord" },
        { "type": "array", "items": { "$ref": "#/$defs/assetRecord" } }
      ]
    },
    "manager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalId", "sourceManagerId", "sources", "sourceFields", "raw", "unresolvedEvidenceIds"],
      "properties": {
        "canonicalId": { "type": "string", "minLength": 1 },
        "sourceManagerId": { "type": ["string", "integer"], "minLength": 1 },
        "definition": { "$ref": "#/$defs/assetGroup" },
        "activeLevels": { "type": "array", "items": { "$ref": "#/$defs/assetRecord" } },
        "promotionMilestones": { "type": "array", "items": { "$ref": "#/$defs/assetRecord" } },
        "rankEffects": { "type": "array", "items": { "$ref": "#/$defs/assetRecord" } },
        "effectFactors": { "type": "array", "items": { "$ref": "#/$defs/assetRecord" } },
        "fragmentMappings": { "type": "array", "items": { "$ref": "#/$defs/assetRecord" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/managerSource" } },
        "sourceFields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assetCount", "assetNames"],
          "properties": {
            "assetCount": { "type": "integer", "minimum": 1 },
            "assetNames": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        },
        "raw": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assets"],
          "properties": { "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assetRecord" } } }
        },
        "unresolvedEvidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
